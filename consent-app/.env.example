# Copy to .env.local (git-ignored) for local development. For the live site,
# firebase/scripts/setup-project.sh writes .env.production (committed).

# "mock" (nothing leaves the page) or "firebase"
VITE_MPMB_BACKEND=mock

# Firebase web app settings (Project settings → Your apps). These identify the
# project; they are not secrets, but access is governed by the security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_REGION=europe-west2
# reCAPTCHA v3 site key once App Check is enabled (recommended in production)
VITE_FIREBASE_APPCHECK_SITE_KEY=
# For the local emulator suite only, e.g. 127.0.0.1:4000
VITE_FIREBASE_EMULATOR_HOST=

# Build-time: "false" removes the prototype controls and the mock from the bundle
MPMB_PROTOTYPE=true

# "on" shows the address finder on the family form (docs/address-lookup.md);
# only once the Ideal Postcodes key is stored. Off: parents type their address.
VITE_MPMB_ADDRESS_LOOKUP=off
