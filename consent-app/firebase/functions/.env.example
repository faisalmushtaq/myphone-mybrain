# Copy to .env in this folder (firebase/functions) before deploying.

# Run Cloud Vision SafeSearch and text detection on every screenshot (the
# Cloud Vision API must be enabled on the project). Off by default.
MPMB_VISION=false

# Vision endpoint; the EU endpoint keeps processing in the EU.
MPMB_VISION_ENDPOINT=eu-vision.googleapis.com

# Refuse calls without a valid App Check token (see docs/firebase.md, step 8).
MPMB_ENFORCE_APP_CHECK=false
