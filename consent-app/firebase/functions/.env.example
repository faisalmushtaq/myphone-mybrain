# Copy to .env in this folder (firebase/functions) before deploying.

# Run Cloud Vision SafeSearch and text detection on every screenshot (the
# Cloud Vision API must be enabled on the project). Off by default.
MPMB_VISION=false

# Vision endpoint; the EU endpoint keeps processing in the EU.
MPMB_VISION_ENDPOINT=eu-vision.googleapis.com

# Refuse calls without a valid App Check token (see docs/firebase.md, step 8).
MPMB_ENFORCE_APP_CHECK=false

# Emails to the team about website enquiries, sent by the enquiry function
# itself over SMTP (Gmail with an app password by default). The password is
# NOT set here: scripts/set-mail-password.sh stores it in Secret Manager under
# MPMB_SMTP_SECRET. Leave MPMB_SMTP_USER empty to store messages without
# emailing anyone. Nothing is ever emailed to families.
MPMB_SMTP_HOST=smtp.gmail.com
MPMB_SMTP_PORT=465
MPMB_SMTP_USER=
MPMB_MAIL_TO=brainpop@leeds.ac.uk
MPMB_MAIL_FROM_NAME=MyPhone/MyBrain
MPMB_SMTP_SECRET=mpmb-smtp-password

# The private bucket the nightly data export is written to (created on first
# run if missing). Default: <project-id>-exports. See scripts/setup-exports.sh.
MPMB_EXPORT_BUCKET=
